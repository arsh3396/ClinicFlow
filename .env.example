# ClinicFlow environment template (FR-CFG-2, FR-CFG-4).
# Copy to `.env` and replace placeholders. Never commit real secrets.

SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty for local SQLite (db.sqlite3).
# Examples:
#   sqlite:///C:/ClinicFlow/db.sqlite3
#   postgres://clinicflow:password@localhost:5432/clinicflow
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0

# mock (default, prints SMS to the Celery worker console) | twilio
SMS_BACKEND=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

REMINDER_LEAD_HOURS=24
# Session idle timeout in seconds (default 30 minutes).
SESSION_COOKIE_AGE=1800
